---
import Dashboard from "../../layouts/dashboard.astro";
---

<Dashboard title="Subir IMG">
    <form id="upload-image-form" class="max-w-xl mx-auto bg-white p-6 rounded-lg shadow-md space-y-6" enctype="multipart/form-data">
        <h2 class="text-2xl font-bold text-gray-800 text-center">Subir imagen a una noticia</h2>

        <div>
        <label for="noticeId" class="block text-sm font-medium text-gray-700 mb-1">ID de la noticia</label>
        <input
            type="text"
            name="noticeId"
            id="noticeId"
            required
            class="w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500"
        />
        </div>

        <div>
        <label for="image" class="block text-sm font-medium text-gray-700 mb-1">Selecciona una imagen</label>
        <input
            type="file"
            name="image"
            id="image"
            accept="image/*"
            required
            class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4
                    file:rounded-full file:border-0
                    file:text-sm file:font-semibold
                  file:bg-indigo-50 file:text-indigo-700
                  hover:file:bg-indigo-100"
        />
        </div>

        <button
        type="submit"
        class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 transition duration-300"
        >
        Subir Imagen
        </button>

        <p id="status-message" class="text-center text-sm text-gray-600"></p>
    </form>
</Dashboard>

<script>
  const form = document.getElementById('upload-image-form');
  const statusMessage = document.getElementById('status-message');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const noticeId = document.getElementById('noticeId').value.trim();
    const formData = new FormData(form);

    const response = await fetch(`http://localhost:3000/api/notices/${noticeId}/image`, {
      method: 'POST',
      body: formData,
    });

    const result = await response.json();
    if (response.ok) {
      statusMessage.textContent = '✅ Imagen subida correctamente';
      statusMessage.classList.remove('text-red-500');
      statusMessage.classList.add('text-green-600');
      form.reset();
    } else {
      statusMessage.textContent = `❌ Error: ${result.message || 'Algo salió mal'}`;
      statusMessage.classList.remove('text-green-600');
      statusMessage.classList.add('text-red-500');
    }
  });
</script>
