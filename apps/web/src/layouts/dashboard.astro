---
export interface Props {
  title: string;
}

import Nombre from "../components/badge/Nombre.astro"
import "../styles/global.css";

const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/unefa.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Menu - {title}</title>
	</head>
	<body class="bg-gris-claro">
		<div class="flex h-screen">

        <aside class="w-44 p-4 flex shadow flex-col items-center">
            <Nombre />
            <nav>
                <ul class="pt-5 grid gap-4 text-center font-medium text-gray-500">
                    <li><a href="/menu" id="inicio" class="block py-2 px-4 rounded-xl transition duration-150 hover:bg-blue-500 hover:text-light-w2">Inicio</a></li>
                    <li><a href="/menu/noticias" id="noticias" class="block py-2 px-4 rounded-xl transition duration-150 hover:bg-blue-500 hover:text-light-w2">Noticias</a></li>
                    <li><a href="/menu/redactar" id="redactar" class="block py-2 px-4 rounded-xl transition duration-150 hover:bg-blue-500 hover:text-light-w2">Redactar</a></li>
                </ul>
            </nav>
        </aside>

        <div class="flex-1 flex flex-col">

            <header class="p-4 shadow flex justify-between items-center">
                <h1 class="text-second-light-v2 text-2xl font-overpass font-bold">Dashboard</h1>

                <div class="h-10 w-10 rounded-full bg-indigo-500 flex items-center justify-center">
                    <span id="avatar" class="text-sm font-medium text-white"></span>
                </div>
                <!-- <button class="bg-blue-600 text-white font-medium px-4 py-2 rounded-lg hover:bg-blue-700">Cerrar sesión</button> -->
            </header>


            <main class="p-6 flex-1">
                <slot />
            </main>
        </div>
    </div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script>
    const token = localStorage.getItem("token");

    fetch("http://localhost:3000/auth/profile", {
    headers: { Authorization: `Bearer ${token}` },
    })
    .then(res => {
        if (!res.ok) {
        window.location.href = "/auth/login";
        throw new Error("Error al obtener perfil");
        }
        return res.json();
    })
    .then(data => {
        document.getElementById("avatar").textContent = data.user.user ? data.user.user.charAt(0) : '?';
    })
    .catch(error => { console.error("Error:", error.message); });
</script>