---
import Layout from '../layouts/Layout2.astro';
import NewsGrid from '../components/notices/NewsGrid.astro';
---

<Layout title="Portal de Noticias">
  <main class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="error-message" class="hidden text-center py-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Error al cargar las noticias</h2>
        <p class="text-gray-600 mb-6">Por favor, intenta recargar la página.</p>
        <button onclick="location.reload()" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-300">
          Reintentar
        </button>
      </div>

      <div id="loading-screen" class="text-center py-16">
        <div class="w-10 h-10 border-4 border-gray-200 border-t-blue-500 rounded-full animate-spin mx-auto mb-4"></div>
        <p class="text-gray-600">Cargando noticias...</p>
      </div>

      <NewsGrid />
    </div>
  </main>
</Layout>

<script>
  import { fetchNews, renderNews, showError, hideLoading } from '../scripts/newsUtils.js';

  async function initializeApp() {
    try {
      const articles = await fetchNews();
      renderNews(articles);
    } catch (error) {
      console.error('Error al cargar noticias:', error);
      showError();
    } finally {
      hideLoading();
    }
  }

  document.addEventListener('DOMContentLoaded', initializeApp);

</script>
