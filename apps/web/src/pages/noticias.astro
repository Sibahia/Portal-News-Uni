---
import Layout from "../layouts/Layout2.astro";

const getAllNotices = async function () {
  try {
    const response = await fetch("http://localhost:3000/api/notices/filters?order=DESC");
    if (!response.ok) throw new Error("No se pudieron cargar las noticias");
    const data = await response.json();
    return data.notices;
  } catch (err) {
    console.error(err);
    return [];
  }
};

const articles = await getAllNotices();
---

<Layout title="Noticias">
  <main class="py-8">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      {articles.length > 0 ? (
        articles.map(article => (
          <article class="bg-white shadow rounded-md overflow-hidden">
            <div class="relative">
              <img
                src={article.image ? article.image : `${article.image}`}
                alt={article.title}
                class="w-full h-64 md:h-96 object-cover rounded-md"
                loading="lazy"
              />
            </div>

            <div class="p-6 md:p-12">
              <div class="text-center mb-8">
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight mb-6">
                  {article.title}
                </h1>

                <div class="flex flex-col sm:flex-row items-center justify-center space-y-4 sm:space-y-0 sm:space-x-8 text-gray-600">
                  <div class="flex items-center space-x-3">
                    <div class="h-10 w-10 rounded-full bg-indigo-500 flex items-center justify-center">
                      <span class="text-sm font-medium text-white">
                        {article.autor ? article.autor.charAt(0) : "?"}
                      </span>
                    </div>
                    <div class="text-left">
                      <div class="flex items-center space-x-1">
                        <i class="fas fa-user w-4 h-4"></i>
                        <span class="font-medium text-gray-900">{article.autor}</span>
                      </div>
                    </div>
                  </div>

                  <div class="hidden sm:block w-px h-6 bg-gray-300"></div>

                  <div class="flex items-center space-x-4 text-sm">
                    <div class="flex items-center space-x-1">
                      <i class="fas fa-calendar w-4 h-4"></i>
                      <span>{new Date(article.time_created).toLocaleString()}</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="border-t border-gray-200 mb-8"></div>

              <div class="noticia-contenido max-w-none text-gray-800 leading-relaxed text-lg">
                <Fragment set:html={article.content} />
              </div>
            </div>
          </article>
        ))
      ) : (
        <p class="text-center text-red-500 font-medium">No se encontraron noticias.</p>
      )}
    </div>
  </main>
</Layout>

<style>
  img {
    border-radius: 0.375rem;
  }

  .noticia-contenido :global(.ql-size-large) {
    font-size: 24px;
  }

  .noticia-contenido :global(img) {
    border-radius: 0.375rem;
  }
</style>

