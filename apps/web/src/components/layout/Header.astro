---
import { Image } from 'astro:assets';
import logo from '../../assets/unefa.webp';
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center font-sans">
            <Image src={logo} alt="Logo de la unefa" width={30} height={10}></Image>
            <a href="/" class="text-xl font-bold uppercase text-gray-900">Portal Noticias</a>
          </div>
          <nav class="hidden md:flex space-x-8 font-dm text-lg">
            <a href="/" class="text-gray-500 hover:text-blue-400 transition-colors duration-300">Inicio</a>
          </nav>
        </div>
      </div>
    </header>
